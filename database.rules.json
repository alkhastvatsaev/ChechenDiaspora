{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      ".indexOn": ["approved"],
      ".read": "auth != null && (auth.token.admin == true || (query.orderByChild == 'approved' && query.equalTo == true))",
      "$memberId": {
        ".write": "auth != null && (auth.token.admin == true || (!data.exists() && newData.child('ownerId').val() == auth.uid && newData.child('approved').val() == false))",
        ".validate": "!newData.exists() || auth.token.admin == true || newData.hasChildren(['ownerId', 'prenom', 'nom', 'profession', 'village', 'teip', 'ville', 'lat', 'lng', 'approved', 'createdAt'])",
        "ownerId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "prenom": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "nom": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "age": { ".validate": "newData.isString() && newData.val().length <= 3" },
        "profession": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "village": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "teip": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "ville": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "approved": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other": { ".validate": "auth.token.admin == true" }
      }
    },
    "tickets": {
      ".indexOn": ["status"],
      ".read": "auth != null && (auth.token.admin == true || (query.orderByChild == 'status' && query.equalTo == 'published'))",
      "$ticketId": {
        ".write": "auth != null && (auth.token.admin == true || (!data.exists() && newData.child('authorId').val() == auth.uid && newData.child('status').val() == 'published') || (data.exists() && data.child('authorId').val() == auth.uid && !newData.exists()))",
        ".validate": "!newData.exists() || newData.hasChildren(['authorId', 'description', 'createdAt', 'status'])",
        "authorId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "authorName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "description": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "ville": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "pays": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "isEmergency": { ".validate": "newData.isBoolean()" },
        "hasAudio": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "status": { ".validate": "newData.val() == 'published' || (auth.token.admin == true && (newData.val() == 'closed' || newData.val() == 'pending'))" },
        "$other": { ".validate": "auth.token.admin == true" }
      }
    },
    "ads": {
      ".read": "auth != null",
      "$adId": {
        ".write": "auth != null && (auth.token.admin == true || (!data.exists() && newData.child('authorId').val() == auth.uid) || (data.exists() && data.child('authorId').val() == auth.uid && !newData.exists()))",
        ".validate": "!newData.exists() || newData.hasChildren(['authorId', 'authorName', 'title', 'description', 'category', 'ville', 'pays', 'createdAt'])",
        "authorId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "authorName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "description": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
        "category": { ".validate": "newData.val() == 'job' || newData.val() == 'housing' || newData.val() == 'aid' || newData.val() == 'business' || newData.val() == 'other'" },
        "ville": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "pays": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "price": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    }
  }
}